# Backend base URL the frontend calls. Optional for local dev — defaults to
# http://localhost:8000/api (see src/api/config.ts). Set this at build time to point a
# deployed frontend at its backend, e.g.:
# VITE_API_BASE_URL=https://api.your-domain.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# Google Sign-In: OAuth 2.0 "Web application" client ID (same value as the backend's
# GOOGLE_CLIENT_ID). When unset, the "Continue with Google" button is hidden.
VITE_GOOGLE_CLIENT_ID=
