# Postgres connection string. Matches the docker-compose service below; override for
# a managed/production database.
DATABASE_URL=postgresql://prehearing:prehearing@localhost:5432/prehearing

# Optional guardrails — shown with their defaults
# MAX_FILES=20
# MAX_FILE_MB=25
# MAX_TOTAL_MB=60
# MAX_PROMPT_CHARS=240000
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_TOKENS=8000
