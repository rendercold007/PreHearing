OPENROUTER_API_KEY=
OPENROUTER_MODEL_CHEAP=
OPENROUTER_MODEL_MID=
OPENROUTER_MODEL_STRONG=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional — the Research stage is skipped when empty
INDIANKANOON_API_TOKEN=

# Postgres connection string. Matches the docker-compose service below; override for
# a managed/production database.
DATABASE_URL=postgresql://prehearing:prehearing@localhost:5433/prehearing

# Browser origins allowed to call the API (CORS), comma-separated. Defaults to the local
# Vite dev server; set to the deployed frontend origin(s) in production, e.g.:
# CORS_ORIGINS=https://app.your-domain.com
CORS_ORIGINS=http://localhost:5173

# Password-reset email via Resend. Without RESEND_API_KEY the reset flow still works but
# logs the reset link to the server instead of emailing it (fine for local dev).
# RESEND_FROM must be a verified sender; onboarding@resend.dev works for testing.
# In production, verify csper.online in Resend and send from it, e.g.
#   RESEND_FROM=Casper <noreply@csper.online>
RESEND_API_KEY=
RESEND_FROM=Casper <onboarding@resend.dev>
# Frontend base URL used to build the reset link (the /reset-password route).
APP_BASE_URL=http://localhost:5173

# Google Sign-In. OAuth 2.0 "Web application" client ID from the Google Cloud Console
# (add your frontend origin to Authorized JavaScript origins). Empty = Google sign-in off.
# The frontend needs the SAME value as VITE_GOOGLE_CLIENT_ID (see frontend/.env.example).
GOOGLE_CLIENT_ID=

# Optional guardrails — shown with their defaults
# MAX_FILES=20
# MAX_FILE_MB=25
# MAX_TOTAL_MB=60
# MAX_PROMPT_CHARS=240000
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_TOKENS=8000
# AUTH_RATE_LIMIT=10
# ANALYZE_RATE_LIMIT=5


RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_PLUS=